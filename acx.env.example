# Copy to acx.env and adjust. Environment variables override values here.

# Container name; also the ssh host alias and key name (~/.ssh/<name>_ed25519).
ACX_NAME=acx-dev
# Home volume. Defaults to <name without -dev>-home.
ACX_VOLUME=acx-home

ACX_CPUS=4
ACX_MEMORY=8g
ACX_VOLUME_SIZE=64G

# Build args (./acx rebuild after changing).
ACX_TZ=Asia/Seoul
ACX_NODE_MAJOR=22
